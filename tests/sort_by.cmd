NEW
REPEAT 6
LET G = (RECNO() > 3)
LET VAL = 7 - RECNO()
RUN
SORT G VAL
PRINT G VAL
RUN

NEW
HOLD SUMVAL
REPEAT 6
LET G = (RECNO() > 3)
LET VAL = RECNO()
RUN
SORT G
BY G
IF FIRST.G = 1 THEN LET SUMVAL = 0
LET SUMVAL = SUMVAL + VAL
PRINT G VAL SUMVAL
IF LAST.G = 1 THEN PRINT "END OF GROUP" G
RUN
UNHOLD SUMVAL
